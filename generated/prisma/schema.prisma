generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model items {
  id          Int         @id @default(autoincrement())
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  label       String?
  description String?
  comment     String?
  parent      Int?
  path        String?
  items       items?      @relation("itemsToitems", fields: [parent], references: [id])
  other_items items[]     @relation("itemsToitems")
  modifiers   modifiers[]
  titles      titles[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model modifiers {
  id            Int      @id @default(autoincrement())
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  function      String   @default("")
  is_recursive  Boolean  @default(false)
  start_index   Int      @default(0)
  title         String   @default("Unknown Modifier")
  description   String
  modifier_item Int
  items         items    @relation(fields: [modifier_item], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model titles {
  id          Int      @id @default(autoincrement())
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  item        Int?
  description String?
  chapter     BigInt?
  plan        BigInt?
  items       items?   @relation(fields: [item], references: [id], onDelete: NoAction, onUpdate: NoAction)
  values      values[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model values {
  date                        DateTime @default(dbgenerated("'2026-01-01'::date")) @db.Date
  is_flexible                 Boolean?
  function                    BigInt?
  title                       Int
  created_at                  DateTime @default(now()) @db.Timestamptz(6)
  should                      BigInt?
  is_expense                  Boolean
  expense_revenue_type        String?
  expense_revenue_description String?
  group                       String?
  group_description           String?
  chapter                     BigInt?
  chapter_description         String?
  plan                        BigInt?
  plan_description            String?
  titles                      titles   @relation(fields: [title], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([date, title])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model charts {
  id         Int      @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  date_from  DateTime @db.Date
  date_until DateTime @db.Date

  @@id([id, date_from, date_until])
}
